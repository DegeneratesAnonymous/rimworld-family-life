<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolation proof, not shipped: Education's pure code compiled against the shared assembly only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Wils.Education.Domain</AssemblyName>
    <RootNamespace>FamilyLife</RootNamespace>
    <OutputPath>../../obj-isolation/education/</OutputPath>
    <BaseIntermediateOutputPath>../../obj-isolation/education-obj/</BaseIntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\FamilyLife\Education\Domain\**\*.cs" />
    <ProjectReference Include="Shared.Domain.csproj" />
  </ItemGroup>
</Project>
