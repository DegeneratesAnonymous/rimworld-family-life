<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests compile the pure Domain folder directly. If Domain ever references Verse/Unity, this project stops building. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FamilyLife.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\FamilyLife\Domain\**\*.cs" LinkBase="Domain" />
    <Compile Include="..\FamilyLife\Framework\**\*.cs" LinkBase="Framework" />
    <Compile Include="..\FamilyLife\Education\Domain\**\*.cs" LinkBase="Education\Domain" />
    <Compile Include="..\FamilyLife\Care\Domain\**\*.cs" LinkBase="Care\Domain" />
    <Compile Remove="obj/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>
</Project>
