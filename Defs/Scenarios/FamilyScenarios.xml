<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Three families arrive together: for each, a father, a mother and two children. Children are a Biotech feature, so the scenario only
    exists with Biotech. The families' marriages and parent links are added when the game starts (see ScenPart_FamiliesStart).
  -->
  <ScenarioDef ParentName="ScenarioBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>WFL_ThreeFamilies</defName>
    <label>Three Families</label>
    <description>Three families, each a mother, a father and two children, signed up together for the long passage to a new rimworld. Twelve of you in all. Nobody here is a stranger to anyone: the adults have kept their households running through hard years, and the children are depending on every one of you.\n\nYou have what a family needs to settle: food, medicine, tools and building materials. What you do not have is time to waste.\n\nNote: the children cannot work or fight, and there are only six adults to feed, shelter and defend twelve, so this is a demanding scenario.</description>
    <scenario>
      <summary>Three families, each a mother, a father and two children, with supplies to settle.</summary>
      <parts>

        <!-- Config page: the starting colonists are generated as families by ScenPart_FamiliesStart -->
        <li Class="FamilyLife.ScenPart_FamiliesStart">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>12</pawnCount>
          <pawnChoiceCount>12</pawnChoiceCount>
        </li>

        <!-- Arrival -->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
          <visible>false</visible>
        </li>

        <!-- Supplies for twelve, six of whom cannot work -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>1200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>150</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>40</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>30</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>40</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>500</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Cloth</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_BoltActionRifle</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_BoltActionRifle</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_Revolver</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_Revolver</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Knife</thingDef>
          <stuff>Steel</stuff>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Knife</thingDef>
          <stuff>Steel</stuff>
        </li>
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <count>2</count>
          <bondToRandomPlayerPawnChance>1.0</bondToRandomPlayerPawnChance>
        </li>

        <!-- Building materials near where everyone lands -->
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>400</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>500</count>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>Three families made the passage together: twelve people, six of them children. The drop pods fall away behind you and the landscape settles into silence.\n\nThe supplies will not last long. Build shelter first, then food, and keep the children close.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

  <!-- A copy of the above with more of everything, for trying the mod out. -->
  <ScenarioDef ParentName="ScenarioBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>WFL_ThreeFamiliesTesting</defName>
