<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Added when someone the pawn was closely attached to dies. The stage follows how strong the attachment was, so losing a
    parent you were very close to hurts more than losing a distant sibling. Small on purpose: the game already has its own
    thoughts for a relative's death, and this only deepens them. It can be switched off in the mod settings.
  -->
  <ThoughtDef>
    <defName>WFL_FamilyGrief</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>4</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>missing someone</label>
        <description>I keep thinking about someone I was fond of.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>grieving someone close</label>
        <description>I lost someone I was close to. The house feels wrong without them.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>devastated by a loss</label>
        <description>I lost someone who was a part of everything I did. I do not know how to go on as before.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

