<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    The stranded reunion party. The quest is created by the mod when a kin visit is held up (it is never generated by the storyteller); it appears in the Quest tab
    and is accepted or ignored by the player. Accepting makes the world site below. The map is the vanilla encounter map, with the relatives placed on it by the mod.
  -->
  <QuestScriptDef>
    <defName>WFL_KinRescue</defName>
    <isRootSpecial>true</isRootSpecial>
    <defaultChallengeRating>1</defaultChallengeRating>
    <root Class="QuestNode_Sequence">
      <nodes />
    </root>
  </QuestScriptDef>

  <WorldObjectDef ParentName="StaticWorldObjectBase">
    <defName>WFL_KinRescueSite</defName>
    <label>stranded relatives</label>
    <description>Relatives of a family in the colony, on their way to a reunion, held up on the road. A caravan can reach them here.</description>
    <worldObjectClass>FamilyLife.WorldObject_KinRescue</worldObjectClass>
    <texture>World/WorldObjects/Camp</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/Camp</expandingIconTexture>
    <expandingIconPriority>80</expandingIconPriority>
    <expandMore>true</expandMore>
    <mapGenerator>Encounter</mapGenerator>
    <overrideMapSize>(110, 1, 110)</overrideMapSize>
    <comps>
      <li Class="WorldObjectCompProperties_FormCaravan" />
    </comps>
  </WorldObjectDef>

  <ThoughtDef>
    <defName>WFL_InheritedKeepsake</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>12</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>carries a keepsake</label><description>I carry something that was theirs. It is not the thing; it is who held it.</description><baseMoodEffect>5</baseMoodEffect></li></stages>
  </ThoughtDef>
</Defs>
