<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>WFL_CheckedUp</defName>
    <label>recent check-up</label>
    <description>The colony's doctor has examined this person recently. Their body copes a little better with illness and mends a little faster.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.62, 0.86, 0.66)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1200000~1200000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <naturalHealingFactor>1.15</naturalHealingFactor>
        <statOffsets>
          <ImmunityGainSpeed>0.2</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
