<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>WFL_CheckedUp</defName>
    <label>recent check-up</label>
    <description>The colony's doctor has examined this person recently. Their body copes better with illness and mends faster, and how much better depends on how good the check-up was.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.35</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <defaultLabelColor>(0.62, 0.86, 0.66)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1200000~1200000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>poor</label>
        <naturalHealingFactor>1.05</naturalHealingFactor>
        <statOffsets><ImmunityGainSpeed>0.08</ImmunityGainSpeed></statOffsets>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>fair</label>
        <naturalHealingFactor>1.15</naturalHealingFactor>
        <statOffsets><ImmunityGainSpeed>0.2</ImmunityGainSpeed></statOffsets>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>good</label>
        <naturalHealingFactor>1.25</naturalHealingFactor>
        <statOffsets><ImmunityGainSpeed>0.3</ImmunityGainSpeed></statOffsets>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>excellent</label>
        <naturalHealingFactor>1.4</naturalHealingFactor>
        <statOffsets><ImmunityGainSpeed>0.45</ImmunityGainSpeed></statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
