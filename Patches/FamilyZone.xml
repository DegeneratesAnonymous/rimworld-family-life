<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Adds the family zone tool to Architect > Zone, right after the growing zone. Shrinking and deleting use the game's own Delete Zone tool. -->
  <Operation Class="PatchOperationInsert">
    <xpath>*/DesignationCategoryDef[defName="Zone"]/specialDesignatorClasses/li[text()="Designator_ZoneAdd_Growing"]</xpath>
    <order>Append</order>
    <value>
      <li>FamilyLife.Designator_ZoneAdd_Family</li>
    </value>
  </Operation>
</Patch>
