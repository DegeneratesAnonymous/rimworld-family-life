<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>WFL_CheckedUp</defName>
    <label>recent check-up</label>
    <description>The colony's doctor has seen this person recently. A good check-up is reassuring and gives a modest, short-lived edge against illness; how much depends on how good it was. It does not treat anything, and later visits do not add to it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.35</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <defaultLabelColor>(0.62, 0.86, 0.66)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1200000~1200000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>brief</label>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>fair</label>
        <naturalHealingFactor>1.03</naturalHealingFactor>
        <statOffsets><ImmunityGainSpeed>0.03</ImmunityGainSpeed></statOffsets>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>good</label>
        <naturalHealingFactor>1.05</naturalHealingFactor>
        <statOffsets><ImmunityGainSpeed>0.06</ImmunityGainSpeed></statOffsets>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>excellent</label>
        <naturalHealingFactor>1.08</naturalHealingFactor>
        <statOffsets><ImmunityGainSpeed>0.09</ImmunityGainSpeed></statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
