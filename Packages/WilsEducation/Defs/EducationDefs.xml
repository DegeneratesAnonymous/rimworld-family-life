<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <JobDef><defName>WFL_OfficeLesson</defName><driverClass>FamilyLife.JobDriver_StoryTalk</driverClass><reportString>giving TargetA a lesson.</reportString><casualInterruptible>true</casualInterruptible></JobDef>
  <JobDef><defName>WFL_ClassTeacher</defName><driverClass>FamilyLife.JobDriver_ClassTeacher</driverClass><reportString>teaching a class.</reportString><casualInterruptible>true</casualInterruptible></JobDef>
  <JobDef><defName>WFL_ClassAssist</defName><driverClass>FamilyLife.JobDriver_ClassAssist</driverClass><reportString>helping in class.</reportString><casualInterruptible>true</casualInterruptible></JobDef>
  <LetterDef>
    <defName>WFL_Assessment</defName>
    <letterClass>FamilyLife.ChoiceLetter_Assessment</letterClass>
    <color>(0.78, 0.8, 0.84)</color>
    <flashColor>(0.78, 0.8, 0.84)</flashColor>
    <arriveSound>LetterArrive</arriveSound>
  </LetterDef>
  <JobDef><defName>WFL_ClassStudent</defName><driverClass>FamilyLife.JobDriver_ClassStudent</driverClass><reportString>attending class.</reportString><casualInterruptible>true</casualInterruptible></JobDef>
  <JobDef><defName>WFL_TestStudent</defName><driverClass>FamilyLife.JobDriver_TestStudent</driverClass><reportString>sitting a test.</reportString><casualInterruptible>true</casualInterruptible></JobDef>
  <ThoughtDef><defName>WFL_InspiringLesson</defName><thoughtClass>Thought_Memory</thoughtClass><durationDays>2</durationDays><stackLimit>1</stackLimit>
    <stages><li><label>inspiring lesson</label><description>The teacher made it all make sense. I wanted to learn more.</description><baseMoodEffect>4</baseMoodEffect></li></stages></ThoughtDef>
  <ThoughtDef><defName>WFL_BoringLesson</defName><thoughtClass>Thought_Memory</thoughtClass><durationDays>2</durationDays><stackLimit>1</stackLimit>
    <stages><li><label>dull, confusing lesson</label><description>I could not follow the teacher, and sitting there was tedious.</description><baseMoodEffect>-3</baseMoodEffect></li></stages></ThoughtDef>
  <ThoughtDef><defName>WFL_TestingProud</defName><thoughtClass>Thought_Memory</thoughtClass><durationDays>6</durationDays><stackLimit>1</stackLimit>
    <stages><li><label>did well in the assessment</label><description>I took part and it went well. I am proud of myself.</description><baseMoodEffect>5</baseMoodEffect></li></stages></ThoughtDef>
  <ThoughtDef><defName>WFL_TestingDone</defName><thoughtClass>Thought_Memory</thoughtClass><durationDays>4</durationDays><stackLimit>1</stackLimit>
    <stages><li><label>finished the assessment</label><description>The assessment is over. I did all right.</description><baseMoodEffect>2</baseMoodEffect></li></stages></ThoughtDef>
  <ThoughtDef><defName>WFL_TestingDisappointed</defName><thoughtClass>Thought_Memory</thoughtClass><durationDays>2</durationDays><stackLimit>1</stackLimit>
    <stages><li><label>a hard assessment</label><description>The assessment did not go as well as I hoped. There is time to do better.</description><baseMoodEffect>-1</baseMoodEffect></li></stages></ThoughtDef>
</Defs>
