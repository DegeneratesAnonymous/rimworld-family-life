<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- A tax collection visit: the framework's shared talk job, with the meaning supplied by Wil's Treasury. -->
  <JobDef>
    <defName>WFL_TaxVisit</defName>
    <driverClass>FamilyLife.JobDriver_StoryTalk</driverClass>
    <reportString>collecting what TargetA owes.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>
  <ThoughtDef>
    <defName>WFL_TaxPaidFairly</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>fair collection</label><baseOpinionOffset>4</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>WFL_TaxPressured</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>pressed for money</label><baseOpinionOffset>-8</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>WFL_TaxRefusedAgainst</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>would not pay what is owed</label><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <!-- Prolonged nonpayment, expressed as opinion of whoever keeps the books and as strain on the worker's household. The wages themselves stay owed in full. -->
  <ThoughtDef>
    <defName>WFL_WagesOwed</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>wages still unpaid</label><baseOpinionOffset>-5</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>WFL_WagesOwedLong</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>12</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>owed wages for a long time</label><baseOpinionOffset>-12</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>WFL_HouseholdStrain</defName>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>family short of money</label><description>Someone in my family has not been paid what they are owed.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>
  <!-- The Treasurer sits at the Treasury chair to deal with waiting financial business. Nothing is decided here; the books were settled when the operation happened. -->
  <JobDef>
    <defName>WFL_TreasuryOffice</defName>
    <driverClass>FamilyLife.JobDriver_TreasuryOffice</driverClass>
    <reportString>seeing to the treasury accounts.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>
</Defs>
